# Copy this file to `.streamlit/secrets.toml` for local development (never commit `secrets.toml`),
# or paste its contents into Streamlit Community Cloud -> App Settings -> Secrets.
# Docs: https://docs.streamlit.io/deploy/streamlit-community-cloud/deploy-your-app/secrets-management

# 1. Gemini API Key (Google AI Studio -> Get API key): https://aistudio.google.com/
GEMINI_API_KEY = ""

# 2. Coach password required in the UI to run live Gemini benchmarks or Force Full Re-Split
GEMINI_ADMIN_PASSWORD = ""

# 3. Cloudflare R2 S3-compatible bucket credentials (Cloudflare Dashboard -> R2 -> Overview -> Manage API Tokens):
#    https://developers.cloudflare.com/r2/api/tokens/
[r2]
endpoint_url = "https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
bucket = "mips-data"
access_key_id = ""
secret_access_key = ""
